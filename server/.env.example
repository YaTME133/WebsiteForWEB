### Пример .env для сервера (папка server)
# Порт HTTP-сервера
PORT=4000

# Секрет для JWT (обязательно смените в продакшене)
JWT_SECRET=supersecret_jwt_key

# Путь до файла SQLite. Относительный путь считается от папки server
DB_PATH=../database/database.sqlite

# Разрешенные источники для CORS (список через запятую) или * для дев
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Раздавать собранный фронтенд (dist) сервером Express
SERVE_CLIENT=false
