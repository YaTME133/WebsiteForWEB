{
  "name": "python-learning-platform-server",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node -e \"import('./seed.js').then(m=>m.seed({includeUsers:false}))\"",
    "seed:users": "node -e \"import('./seed.js').then(m=>m.seed({includeUsers:true}))\"",
    "seed:reset": "node -e \"process.env.RESET_DB='true'; import('./seed.js').then(m=>m.seed({includeUsers:false}))\"",
    "seed:reset:users": "node -e \"process.env.RESET_DB='true'; import('./seed.js').then(m=>m.seed({includeUsers:true}))\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}
